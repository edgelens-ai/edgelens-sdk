# Copy to .env and fill in your values. .env is gitignored — never commit it.

# Required. Mint one in the customer portal at /app/keys → Create.
EDGELENS_API_KEY=el_test_xxxxxxxxxxxxxxxxxxxx

# Optional. Leave commented to use the cloud default (https://api.edgelens.ai).
# For a self-hosted / dev deployment, uncomment and set it.
# EDGELENS_BASE_URL=https://<your-api-host>
