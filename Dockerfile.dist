# The image `make dist`, `make dist-check` and `make publish-pypi` run the
# Python packaging tools in.
#
# A separate file for the same reason as Dockerfile.test: the release
# tooling (build, twine) must never ride along in an image that is itself
# shipped. The npm half needs no image of its own; the targets run the
# pinned node base directly, because npm is already in it.
#
# Pinned so that `make dist` gives the same artifacts next month as today.
# The build backend itself (hatchling) is fetched by `python -m build` into
# an isolated environment, at the floor each pyproject.toml declares.

FROM docker.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

RUN pip install --no-cache-dir --root-user-action=ignore \
      build==1.6.1 \
      twine==7.0.0

# Rootless podman can run as a non-root uid with HOME unset; pip and twine
# both want somewhere to write a cache or a config file.
ENV HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

CMD ["python3", "-m", "build", "--help"]
