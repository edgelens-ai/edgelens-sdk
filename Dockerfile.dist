# The image `make dist`, `make dist-check` and `make publish-pypi` run the
# Python packaging tools in.
#
# A separate file for the same reason as Dockerfile.test: the release
# tooling (build, twine) must never ride along in an image that is itself
# shipped. The npm half needs no image of its own; the targets run the
# pinned node base directly, because npm is already in it.
#
# The build frontend and backend live in their own venv, /opt/build,
# installed from scripts/release/build-requirements.txt with every wheel
# pinned by sha256. build-python.sh builds with --no-isolation from that
# venv, so a build fetches nothing and the same commit gives the same
# artifact bytes on every run. twine only checks and uploads finished
# artifacts and is pinned by version.

FROM docker.io/library/python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

COPY scripts/release/build-requirements.txt /opt/build-requirements.txt
RUN python3 -m venv /opt/build \
 && /opt/build/bin/pip install --no-cache-dir --disable-pip-version-check \
      --require-hashes --only-binary :all: -r /opt/build-requirements.txt \
 && pip install --no-cache-dir --root-user-action=ignore twine==7.0.0

# Rootless podman can run as a non-root uid with HOME unset; pip and twine
# both want somewhere to write a cache or a config file.
ENV HOME=/tmp \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore

CMD ["/opt/build/bin/python", "-m", "build", "--help"]
