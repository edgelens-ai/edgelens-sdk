# The image `make test` (typescript half) runs core/typescript/tests and
# integrations/playwright/tests in.
#
# WHY A SEPARATE FILE AND A SEPARATE IMAGE.
#
# One image mixing Python and Node is a bigger image for every target, and
# couples the two language toolchains' version bumps into one rebuild. The
# Python side (Dockerfile.test) is the primary gate; this one is small on
# purpose. See the Dockerfile.test header for the reason both files sit at
# this layer rather than as stages in a shipped Dockerfile.
#
# WHY node_modules IS BAKED AND THE SOURCES ARE MOUNTED.
#
# The sibling Python image can bind-mount its live tree because an editable
# pip install writes .pth entries that resolve through the mount at run
# time. Node has no such indirection: vitest resolves imports by scanning
# node_modules relative to the test file, and a read-only bind-mount of a
# whole package over the baked image would hide the installed modules
# behind the host's node_modules (absent, or built for another platform).
# So node_modules stays in the image, and the Makefile mounts only src/,
# tests/, vitest.config.ts and core/testdata/ over the copies baked below.
# The baked copies make the image runnable on its own; the mounts make the
# Makefile's test run exercise the working tree. A package.json or lockfile
# change wants `make test-rebuild`.
#
# TWO PACKAGES, ONE TREE.
#
# The tree under /sdk mirrors the repo, so the Playwright plugin's
# `file:../../core/typescript` devDependency resolves to the core package
# beside it, and its vitest config points @edgelens/core at the core
# sources.

FROM docker.io/library/node:20-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

# `npm ci` (not `npm install`) installs strictly from package-lock.json
# without re-resolving. This is the whole reason the lockfile is committed:
# a fresh install resolves ranges from scratch and would make the suite's
# result a function of the date rather than of the commit. `npm ci` fails
# loudly if package.json and the lockfile disagree, which is the right
# direction -- a lockfile the sources no longer match is a lockfile that
# has stopped protecting the pin.
#
# --chown=node:node on every COPY and the chown on WORKDIR itself: the base
# image's default USER is `node` (uid 1000), but a `WORKDIR` the image
# creates implicitly is owned by root. vite -- which vitest hands the
# `vitest.config.ts` to -- compiles the config to a sibling
# `vitest.config.ts.timestamp-<nanos>.mjs` and refuses to proceed if it
# cannot (measured: `EACCES: permission denied, open ... .timestamp-...mjs`).
# Everything the suite needs to WRITE lives under /sdk, so owning the tree
# with the running user is the straight fix; the package directories are
# made by that user before anything is copied into them, because a
# directory COPY creates implicitly is owned by root. --network none at
# test time makes the write-to-the-tree surface small on purpose: there is
# no shared node_modules cache, no --prefix outside /sdk, and the whole
# suite is in this one tree.
WORKDIR /sdk
RUN chown node:node /sdk
USER node
RUN mkdir -p /sdk/core/typescript /sdk/core/testdata /sdk/integrations/playwright

COPY --chown=node:node core/typescript/package.json core/typescript/package-lock.json /sdk/core/typescript/
RUN cd /sdk/core/typescript && npm ci --no-audit --no-fund

# After core: the plugin's lockfile links @edgelens/core to ../../core/typescript.
COPY --chown=node:node integrations/playwright/package.json integrations/playwright/package-lock.json /sdk/integrations/playwright/
RUN cd /sdk/integrations/playwright && npm ci --no-audit --no-fund

# The test sources themselves, so the image runs on its own; the Makefile
# mounts the working tree's copies over them. Each vitest.config.ts points
# at its package's `tests/**/*.test.ts`.
COPY --chown=node:node core/testdata /sdk/core/testdata
COPY --chown=node:node core/typescript/src /sdk/core/typescript/src
COPY --chown=node:node core/typescript/tests /sdk/core/typescript/tests
COPY --chown=node:node core/typescript/vitest.config.ts core/typescript/tsconfig.json /sdk/core/typescript/
COPY --chown=node:node integrations/playwright/src /sdk/integrations/playwright/src
COPY --chown=node:node integrations/playwright/tests /sdk/integrations/playwright/tests
COPY --chown=node:node integrations/playwright/vitest.config.ts integrations/playwright/tsconfig.json /sdk/integrations/playwright/

# No ENTRYPOINT. The Makefile picks the package (-w) and the command; each
# package has `vitest` under its node_modules/.bin and `npm test` runs it.
WORKDIR /sdk/core/typescript
CMD ["npm", "test"]
